# PostgreSQL connection string (Railway provides this automatically when you
# attach a Postgres service: reference it as ${{Postgres.DATABASE_URL}}).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/str1k3?schema=public"

# Optional: database connections per server process (default 5).
# DATABASE_POOL_SIZE=5

# Time zone used to display dates and to decide what "today" is.
APP_TIMEZONE="Asia/Singapore"

# Session policy (days). Idle = signed out after this long without activity.
SESSION_IDLE_DAYS=7
SESSION_MAX_DAYS=30

# Set to "false" ONLY for local http:// testing. Must be true in production.
COOKIE_SECURE=true

# Used once by `npm run db:seed` to create the first administrator if no
# instructor accounts exist. Change the password after first sign-in.
ADMIN_EMAIL="admin@example.com"
ADMIN_NAME="Administrator"
ADMIN_PASSWORD="change-me-to-a-long-password"
